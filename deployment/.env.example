# ══════════════════════════════════════════════════════════════════════════════
# Intervista Platform — Deployment Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# WARNING: Never commit the actual .env file to source control.
#
# ══════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────────────────────
# Public URL of the frontend (used for CORS, email links, redirects)
# For testing: http://<DROPLET_IP>  or  https://your-domain.com
FRONTEND_URL=http://localhost

# ────────────────────────────────────────────────────────────────────────────
# DATABASE — .NET APIs (Npgsql connection string format)
# ────────────────────────────────────────────────────────────────────────────
# Used by: supabase-user-api, supabase-company-api, supabase-transaction-api
# Format: Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<pass>;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Timeout=60;Command Timeout=60;Keepalive=30
DB_CONNECTION_STRING_DOTNET=

# ────────────────────────────────────────────────────────────────────────────
# DATABASE — Node.js Data Service (PostgreSQL URI format)
# ────────────────────────────────────────────────────────────────────────────
# Used by: data-service
# Format: postgresql://<user>:<password>@<host>:5432/postgres
DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# DATABASE — Python Coding Module (PostgreSQL URI format)
# ────────────────────────────────────────────────────────────────────────────
# Used by: coding-service
CODING_DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# DATABASE — Python Interview Module (PostgreSQL URI format)
# ────────────────────────────────────────────────────────────────────────────
# Used by: interview-service
INTERVIEW_DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# DATABASE — Python Communication Module (PostgreSQL URI format)
# ────────────────────────────────────────────────────────────────────────────
# Used by: communication-service
COMMUNICATION_DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# SUPABASE
# ────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION — JWT
# ────────────────────────────────────────────────────────────────────────────
# Must be at least 32 characters long. Shared by all .NET APIs + coding-service.
JWT_SECRET_KEY=
JWT_ISSUER=KnitnetBackend
JWT_AUDIENCE=KnitnetFrontend
JWT_EXPIRY_HOURS=3

# ────────────────────────────────────────────────────────────────────────────
# AI / LLM — Dual Provider (DigitalOcean Agent + Groq)
# ────────────────────────────────────────────────────────────────────────────
# Used by: interview-service, communication-service
DO_AGENT_API_URL=https://uzckna56e2tkarlzb32dcxyl.agents.do-ai.run
DO_AGENT_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ────────────────────────────────────────────────────────────────────────────
# AZURE SPEECH (Text-to-Speech)
# ────────────────────────────────────────────────────────────────────────────
# Used by: interview-service, communication-service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ────────────────────────────────────────────────────────────────────────────
# JUDGE0 — Code Execution Engine
# ────────────────────────────────────────────────────────────────────────────
# Used by: coding-service
JUDGE0_URL=
JUDGE0_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# EMAIL — Brevo Transactional Email
# ────────────────────────────────────────────────────────────────────────────
# Used by: mail-server
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Intervista
BREVO_REPLY_TO=

# Legacy Gmail (kept for contact form fallback, optional)
EMAIL_USER=
EMAIL_PASS=

# ────────────────────────────────────────────────────────────────────────────
# ADMIN
# ────────────────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=admin123

# ────────────────────────────────────────────────────────────────────────────
# RAZORPAY — Payment Processing (Transaction API, optional)
# ────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# SUPABASE STORAGE BUCKETS (Optional — defaults shown)
# ────────────────────────────────────────────────────────────────────────────
# SUPABASE_PROFILE_IMAGES_BUCKET=profile-images
# SUPABASE_COMPANY_LOGOS_BUCKET=company-logos
# SUPABASE_VERIFICATION_DOCS_BUCKET=verification-docs
